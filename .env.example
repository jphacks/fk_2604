# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase publishable/anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Public application URL, without a required trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secret for invite URL tokens (long random string, keep it fixed once deployed)
INVITE_SECRET=change-me-to-a-long-random-string
# Upstash Redis REST API (message storage)
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token
# Server only: never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Edge Function/Vault only (not needed by Next.js)
# FILE_MAINTENANCE_SECRET=<random-secret-at-least-32-bytes>
